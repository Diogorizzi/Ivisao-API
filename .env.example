# ── SERVER ─────────────────────────────────────────────────────────────────────
PORT=7777
# "production" desabilita /docs, /redoc e /openapi.json publicamente.
# Use "development" apenas localmente para acessar a documentação interativa.
ENVIRONMENT=production

# ── PROJECT IDENTITY ───────────────────────────────────────────────────────────
PROJECT_NAME="My Agent API"
COMPANY_NAME="My Company"
COMPANY_DESCRIPTION="An intelligent agent platform."

# ── LLM PROVIDERS ──────────────────────────────────────────────────────────────
# Set at least one. The server detects which are available at startup.
# Use "provider:model_id" format in config/agents.yaml.
#
# Examples:
#   openai:gpt-4o-mini | openai:gpt-4o
#   anthropic:claude-3-5-haiku-20241022 | anthropic:claude-sonnet-4-20250514
#   google:gemini-2.0-flash | google:gemini-1.5-pro
#   groq:llama-3.3-70b-versatile
#   openrouter:anthropic/claude-3.5-sonnet
#   bedrock:anthropic.claude-3-5-haiku-20241022-v1:0
#   vertex:claude-sonnet-4@20250514

OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY=""
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."

# AWS Bedrock (Option A: project-prefixed — recommended to avoid conflicts)
BEDROCK_AWS_ACCESS_KEY_ID=""
BEDROCK_AWS_SECRET_ACCESS_KEY=""
BEDROCK_AWS_REGION="us-east-1"
# AWS Bedrock (Option B: use standard AWS SDK env vars if already configured)
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION

# Google Vertex AI (Option A: project-prefixed — recommended)
VERTEX_PROJECT_ID=""
VERTEX_LOCATION="us-east5"
VERTEX_CREDENTIALS_FILE=""   # path to service account JSON
# Google Vertex AI (Option B: standard GCP SDK env vars if already configured)
# GOOGLE_CLOUD_PROJECT, GOOGLE_APPLICATION_CREDENTIALS

# ── DATABASE ───────────────────────────────────────────────────────────────────
# Main agent/session storage
DATABASE_URL="sqlite:///agno.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg://user:pass@host:5432/dbname"

# SQLite path for admin tables (knowledge_documents, departments, skills)
# Leave empty to use agno.db in the current directory.
# In Docker set to /app/data/agno.db (see docker-compose.prod.yml)
SQLITE_DB_PATH=""

# ── MCP SERVERS (per-user tool injection) ──────────────────────────────────────
# Allows users to connect their own MCP servers.
# If MCP_DB_URL is not set, MCP injection is disabled — everything else works normally.
#
# 1. Create a PostgreSQL database (any provider: Neon, Supabase, Railway, etc.)
# 2. Set MCP_DB_URL below — that's it.
#
# MCP_ENCRYPTION_KEY is optional: if omitted, a key is generated automatically
# on first startup and stored in the database. Leave it blank unless you need
# to rotate keys or migrate data between deployments.
#
# WARNING: If you set MCP_ENCRYPTION_KEY manually, never change it after users
#          have connected servers — existing credentials will become unreadable.
MCP_DB_URL=""
MCP_ENCRYPTION_KEY=""

# ── ADMIN PANEL ────────────────────────────────────────────────────────────────
# Manages RAG knowledge documents at /admin
#
# Generate password hash:
#   uv run python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
# Generate secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_GENERATED_HASH
ADMIN_SECRET_KEY=replace-with-a-random-32-char-string!!
ADMIN_SESSION_TTL=28800

# ── CHROMADB (vector store for RAG) ───────────────────────────────────────────
# Default: connects to localhost:8000
# Override when running in Docker or pointing to a remote instance.
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# ── NEO4J (optional — graph memory) ───────────────────────────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
